# port
VITE_PORT = 3100

#  网站标题
VITE_GLOB_APP_TITLE = 郑州商学院教材管理平台

# 简称，此变量只能是字符/下划线
VITE_GLOB_APP_SHORT_NAME = 教材管理平台

# 单点登录服务端地址
VITE_GLOB_APP_CAS_BASE_URL=http://authserver.zbu.edu.cn/authserver

# 是否开启单点登录
VITE_GLOB_APP_OPEN_SSO = true

# 开启微前端模式
VITE_GLOB_APP_OPEN_QIANKUN=true

# 文件预览地址
VITE_GLOB_ONLINE_VIEW_URL=http://fileview.jeecg.com/onlinePreview


